# Normalise line endings in the repository (source files are stored with LF)
* text=auto

*.c        text
*.h        text
*.s        text
*.py       text
*.md       text
*.txt      text
*.ioc      text
*.uvprojx  text
*.uvoptx   text
*.dbgconf  text
*.scvd     text

# Binary artefacts
*.pdf      binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.hex      binary
*.bin      binary
*.axf      binary
*.o        binary
*.uvguix.* binary
